{
  "name": "uw-tc4",
  "version": "4.0.0-alpha.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "journeys": "playwright test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/data test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:desktop && npm run build && npm run docs:gate",
    "prove": "node scripts/prove.mjs",
    "docs:gate": "node scripts/docs-gate.mjs",
    "prepare": "husky",
    "test:desktop": "node --test scripts/desktop-bootstrap.test.cjs scripts/smoke-export.test.cjs scripts/smoke-api.test.cjs",
    "dev:annotate": "node scripts/annotate-i18n.mjs && concurrently -k -n vite,annotate -c cyan,magenta \"vite --mode annotate\" \"react-grab-annotate --dir \\\"$HOME\\\" --base-dir .tc4-annotations\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bible-reference-range": "1.1.1",
    "fflate": "0.8.2",
    "proskomma-core": "0.11.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "string-punctuation-tokenizer": "2.0.0",
    "usfm-js": "3.4.3",
    "uw-wordmapbooster": "1.0.5",
    "word-aligner": "1.0.3",
    "word-aligner-lib": "1.0.1",
    "wordmap": "0.6.2",
    "wordmap-lexer": "0.3.6"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "eslint --config eslint.complexity.config.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@gabrielaillet/word-aligner-rcl": "1.3.18",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.9",
    "@vitejs/plugin-react": "4.7.0",
    "@zip.js/zip.js": "2.18.2",
    "concurrently": "10.0.5",
    "esbuild": "0.25.12",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.4",
    "prop-types": "15.8.1",
    "rcedit": "5.0.2",
    "react-grab-annotate": "0.1.40",
    "react-redux": "7.2.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "6.4.3",
    "vite-plugin-node-polyfills": "0.24.0",
    "vitest": "4.1.10"
  }
}
